<?xml version="1.0" encoding="ASCII"?>
<mutatorenvironment:MutatorEnvironment xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mutatorenvironment="http://mutatorenvironment/1.0">
  <definition xsi:type="mutatorenvironment:Program" metamodel="/MutationTestingApp/data/model/lib.ecore" output="data/out/" exhaustive="true">
    <source path="data/model/"/>
  </definition>
  <blocks name="m1">
    <commands xsi:type="mutatorenvironment:SelectObjectMutator" name="ev">
      <object xsi:type="mutatorenvironment:RandomTypeSelection">
        <type href="../model/lib.ecore#//Event"/>
      </object>
    </commands>
    <commands xsi:type="mutatorenvironment:ModifyInformationMutator">
      <object xsi:type="mutatorenvironment:SpecificObjectSelection" objSel="//@blocks.0/@commands.0"/>
      <attributes xsi:type="mutatorenvironment:AttributeScalar">
        <attribute href="../model/lib.ecore#//INamedElement/comment"/>
        <value xsi:type="mutatorenvironment:SpecificStringType" value="made by Pablo"/>
      </attributes>
    </commands>
  </blocks>
  <blocks name="m2">
    <commands xsi:type="mutatorenvironment:ModifyInformationMutator">
      <object xsi:type="mutatorenvironment:RandomTypeSelection">
        <type href="../model/lib.ecore#//Position"/>
      </object>
      <attributes xsi:type="mutatorenvironment:AttributeScalar">
        <attribute href="../model/lib.ecore#//Position/x"/>
        <value xsi:type="mutatorenvironment:SpecificDoubleType" value="1.0"/>
      </attributes>
      <attributes xsi:type="mutatorenvironment:AttributeScalar">
        <attribute href="../model/lib.ecore#//Position/y"/>
        <value xsi:type="mutatorenvironment:SpecificDoubleType" value="1.0"/>
      </attributes>
    </commands>
  </blocks>
</mutatorenvironment:MutatorEnvironment>
